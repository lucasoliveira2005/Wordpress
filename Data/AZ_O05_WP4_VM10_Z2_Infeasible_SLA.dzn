% ================================================================
% Instance: AZ_O05_WP4_VM10_Z2_Infeasible_SLA.dzn
% Course: Symbolic Explainable Artificial Intelligence (S-XAI)
% Problem: WordPress Multi-AZ Cloud Deployment (CSPLib prob090 Extension)
% Description: Controlled Infeasible: 5 offers, MySQL split across Z1 & Z2, latency (50ms) > SLA (10ms)
% Parameters: WPInstances=4 | VM Slots=10 | Zones=2 | Offers=5
% SLA: MaxAllowedLatency = 10 ms (VMZone dynamically assigned by solver)
% ================================================================

% --- AVAILABILITY ZONE EXTENSION PARAMETERS ---
NoZones = 2;

% --- NETWORK LATENCY SLA PARAMETERS ---
% Inter-zone latency matrix (milliseconds)
ZoneLatency = [|
        0,  50
    |  50,   0
|];

% Maximum allowed latency for WordPress <-> MySQL communication (ms)
MaxAllowedLatency = 10;

% --- BASE HARDWARE & COMPONENT PARAMETERS ---
WPInstances = 4;
VM = 10;
NoComponents = 5;
HardwareREQ = 3;
VMOffers = 5;

CompREQ = [|
2, 512, 1000,
|     2, 512, 2000,
|     4, 2048, 500,
|     4, 2048, 500,
|     4, 4000, 500
|];

VMSpecs = [|
    64, 976000, 1000,
|    16, 122000, 2000,
|    8, 68400, 2000,
|    4, 30500, 1000,
|    1, 3750, 1000,
|];

VMPrice = [
    8403, 1373, 1301, 379, 98
];
