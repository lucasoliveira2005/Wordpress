% ================================================================
% Instance: AZ_O05_WP3_VM8_Z2_Metro.dzn
% Course: Symbolic Explainable Artificial Intelligence (S-XAI)
% Problem: WordPress Multi-AZ Cloud Deployment (CSPLib prob090 Extension)
% Description: Metro low-latency: 5 offers, 3 WP, 8 VMs, 2 Metro zones (1-3ms), SLA 5ms
% Parameters: WPInstances=3 | VM Slots=8 | Zones=2 | Offers=5
% SLA: MaxAllowedLatency = 5 ms (VMZone dynamically assigned by solver)
% ================================================================

% --- AVAILABILITY ZONE EXTENSION PARAMETERS ---
NoZones = 2;

% --- NETWORK LATENCY SLA PARAMETERS ---
% Inter-zone latency matrix (milliseconds)
ZoneLatency = [|
        0,   2
    |   2,   0
|];

% Maximum allowed latency for WordPress <-> MySQL communication (ms)
MaxAllowedLatency = 5;

% --- BASE HARDWARE & COMPONENT PARAMETERS ---
WPInstances = 3;
VM = 8;
NoComponents = 5;
HardwareREQ = 3;
VMOffers = 5;

CompREQ = [|
2, 512, 1000,
|     2, 512, 2000,
|     4, 2048, 500,
|     4, 2048, 500,
|     4, 4000, 500
|];

VMSpecs = [|
    64, 976000, 1000,
|    16, 122000, 2000,
|    8, 68400, 2000,
|    4, 30500, 1000,
|    1, 3750, 1000,
|];

VMPrice = [
    8403, 1373, 1301, 379, 98
];
